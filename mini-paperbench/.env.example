# 사용법
#   1. 이 파일을 복사한다:   cp .env.example .env
#   2. 권한을 바꾼다:        chmod 600 .env
#   3. .env에 키를 넣는다.   (이 파일에는 키를 넣지 않는다)

# 1순위: Gemini
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.5-flash-lite
LLM_API_KEY=

# 2순위: OpenAI
# 바꿀 때는 위의 두 줄(LLM_BASE_URL, LLM_MODEL)을 아래 값으로 바꾸고, LLM_API_KEY에 OpenAI 키를 넣는다.
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-5-nano

# k3s에서 Claude 구독(claude-bridge)을 쓸 때 (k8s/10-configmap.yaml이 claude-bridge를 가리킬 때)
#   LLM_API_KEY: 브리지 접속용 아무 긴 문자열 (예: openssl rand -hex 24). 워커와 브리지가 같은 값을 쓴다.
#   CLAUDE_CODE_OAUTH_TOKEN: 내 컴퓨터에서 `claude setup-token`으로 만든 토큰 (1년 유효). 남에게 주지 않는다.
CLAUDE_CODE_OAUTH_TOKEN=

# 1이면 LLM을 부르지 않는다. MOCK_DELAY_SEC초 기다린 뒤 0 또는 1을 무작위로 준다.
MOCK_JUDGE=0
MOCK_DELAY_SEC=3
