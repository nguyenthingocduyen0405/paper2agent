# 사용법
#   1. 이 파일을 복사한다:   cp .env.example .env
#   2. 권한을 바꾼다:        chmod 600 .env
#   3. .env에 키를 넣는다.   (이 파일에는 키를 넣지 않는다)

# 1순위: Gemini
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.5-flash-lite
LLM_API_KEY=

# 2순위: OpenAI
# 바꿀 때는 위의 두 줄(LLM_BASE_URL, LLM_MODEL)을 아래 값으로 바꾸고, LLM_API_KEY에 OpenAI 키를 넣는다.
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-5-nano

# 1이면 LLM을 부르지 않는다. MOCK_DELAY_SEC초 기다린 뒤 0 또는 1을 무작위로 준다.
MOCK_JUDGE=0
MOCK_DELAY_SEC=3
